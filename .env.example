# Configuración de Base de Datos (Supabase - Gratis)
# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.AAAAAA:[YOUR-PASSWORD]@AAAAA:xxxx/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.AAAAA:[YOUR-PASSWORD]@AAAAA:xxxx/postgres"

# URL de la API (Ya no necesaria si usas Next.js Fullstack, pero la mantenemos por ahora)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Autenticación y Administración
JWT_SECRET="your-super-secret-jwt-key"
ADMIN_PASSWORD="your-admin-password"
