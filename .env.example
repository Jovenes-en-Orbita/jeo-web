# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_USER=jeo_user
POSTGRES_PASSWORD=jeo_secret_password
POSTGRES_DB=jeo_db
POSTGRES_PORT=5432

# ============================================
# Backend (NestJS)
# ============================================
# Connection string for Prisma (used inside Docker)
DATABASE_URL=postgresql://jeo_user:jeo_secret_password@db:5432/jeo_db?schema=public

# Backend port
BACKEND_PORT=3001

# Node environment
NODE_ENV=development

# ============================================
# Frontend (Next.js)
# ============================================
# API URL that the frontend uses to reach the backend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend port
FRONTEND_PORT=3000
